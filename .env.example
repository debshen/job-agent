# =============================================================================
# .env.example — copy this file to `.env` and fill in your real values.
# `.env` is listed in .gitignore so it stays out of commits by default.
# Still check `git status` before every push, and never paste keys elsewhere.
# =============================================================================

# Get yours at: https://console.anthropic.com/settings/keys
# Looks like: sk-ant-api03-...
ANTHROPIC_API_KEY=

# Layer 05 (Act / digest email) needs these:
# Get yours at: https://resend.com/api-keys (sign up first, free)
# Looks like: re_...
RESEND_API_KEY=

# Where the daily digest email goes. The digest (job matches, and any
# LinkedIn connection names used for the warm bonus) is sent through Resend.
DIGEST_TO_EMAIL=

# Optional: override where the SQLite database lives.
# Default is data/jobs.sqlite at the project root.
# JOB_AGENT_DB=/absolute/path/to/jobs.sqlite
